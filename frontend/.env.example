# Base URL of the Spring Boot backend (no trailing slash).
# Copy this file to .env.local to override the default.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Phase 3.0: Keycloak (see infrastructure/docker-compose.yml and infrastructure/keycloak/taskflow-realm.json).
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8180
NEXT_PUBLIC_KEYCLOAK_REALM=taskflow
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=taskflow-web
