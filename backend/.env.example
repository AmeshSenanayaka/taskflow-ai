# TaskFlow AI backend - example environment. Copy to backend/.env and export before starting:
#   bash:        set -a && source .env && set +a && mvn spring-boot:run
#   PowerShell:  Get-Content .env | ? { $_ -match '^\s*[^#]' } | % { $k,$v = $_ -split '=',2; Set-Item "env:$k" $v }; mvn spring-boot:run
# Never commit a real .env (it is git-ignored).

# --- Database (Phase 0) ---
DB_URL=jdbc:postgresql://localhost:5432/taskflow
DB_USERNAME=taskflow
DB_PASSWORD=taskflow
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Azure OpenAI via Azure AI Foundry (Phase 1) ---
# Resource endpoint, e.g. https://my-foundry-resource.openai.azure.com/
AZURE_OPENAI_ENDPOINT=
# Key from the Azure AI Foundry project > Deployments > your deployment > Endpoint > Key
AZURE_OPENAI_API_KEY=
# The *deployment name* you chose in Azure AI Foundry (not the model name), e.g. gpt-4o-mini
AZURE_OPENAI_DEPLOYMENT_NAME=
# Optional. Leave blank to use the latest API version supported by the Azure SDK (recommended).
AZURE_OPENAI_API_VERSION=

# Optional tuning (defaults shown)
AZURE_OPENAI_TEMPERATURE=0.2
AZURE_OPENAI_MAX_TOKENS=1024
AZURE_OPENAI_TIMEOUT=30s
AZURE_OPENAI_MAX_RETRIES=1
AZURE_OPENAI_LOG_REQUESTS=false

# --- Agent behaviour (defaults shown) ---
AI_MAX_TOOL_ROUND_TRIPS=8
AI_MEMORY_MAX_MESSAGES=30
AI_MEMORY_RETENTION=2h
AI_MEMORY_MAX_CONVERSATIONS=500
AI_CONFIRMATION_TTL=5m
TASKFLOW_DEV_USER_ID=local-user
