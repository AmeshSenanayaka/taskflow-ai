# TaskFlow AI backend - example environment. Copy to backend/.env and export before starting:
#   bash:        set -a && source .env && set +a && mvn spring-boot:run
#   PowerShell:  Get-Content .env | ? { $_ -match '^\s*[^#]' } | % { $k,$v = $_ -split '=',2; Set-Item "env:$k" $v }; mvn spring-boot:run
# Never commit a real .env (it is git-ignored).

# --- Database (Phase 0) ---
DB_URL=jdbc:postgresql://localhost:5432/taskflow
DB_USERNAME=taskflow
DB_PASSWORD=taskflow
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- OpenAI (Phase 1 and 2) ---
# Required for the assistant. Create one at https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Any chat model with tool calling; gpt-4o-mini is cheap and fast enough for the demo.
OPENAI_MODEL_NAME=gpt-4o-mini
OPENAI_TEMPERATURE=0.2
# Log full request/response bodies, including task text. Development only.
OPENAI_LOG_REQUESTS=false
OPENAI_LOG_RESPONSES=false

# --- TaskAgent (Phase 1) ---
AI_MEMORY_MAX_MESSAGES=30

# --- TaskFlowSupervisor (Phase 2), defaults shown ---
# Sub-agent invocations allowed per message; each costs at least two LLM calls.
AI_SUPERVISOR_MAX_AGENT_INVOCATIONS=5
# Tool calls allowed inside one sub-agent invocation.
AI_SUPERVISOR_MAX_TOOL_ROUND_TRIPS=8
# The supervisor planner's own memory window per conversation.
AI_SUPERVISOR_MEMORY_MAX_MESSAGES=20
# LAST = last agent's answer verbatim (planner recap only when no agent was called), SUMMARY, SCORED.
AI_SUPERVISOR_RESPONSE_STRATEGY=LAST
# CHAT_MEMORY, SUMMARIZATION or CHAT_MEMORY_AND_SUMMARIZATION.
AI_SUPERVISOR_CONTEXT_STRATEGY=CHAT_MEMORY

# The AI_MEMORY_RETENTION / AI_MEMORY_MAX_CONVERSATIONS / AI_CONFIRMATION_TTL keys still present in application.yml
# are reserved and not read by the current code.
