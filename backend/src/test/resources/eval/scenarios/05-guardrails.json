        "INPUT_OUT_OF_SCOPE"
      ],
      "responseContains": [
        "only help with your tasks"
      ]
    }
  },
  {
    "id": "I04",
    "title": "An answer that mentions a task the user does not have is repaired by the agent before it is shown",
    "category": "GUARDRAIL",
    "fixture": [
      {
        "key": "a",
        "title": "Prepare sprint review",
        "priority": "HIGH",
        "dueDate": "2026-11-09"
      },
      {
        "key": "b",
        "title": "Reply to customer emails",
        "priority": "MEDIUM"
      }
    ],
    "turns": [
      "Summarise my open tasks"
    ],
    "script": [
      {
        "invokeAgent": "SummaryAgent",
        "request": "Summarise my open tasks"
      },
      {
        "toolCall": "findTasks",
        "arguments": {
          "statuses": [
            "TODO",
            "IN_PROGRESS"
          ]
        }
      },
      {
        "text": "You have 3 open tasks: \"Prepare sprint review\" (HIGH, due today), \"Reply to customer emails\" and \"Book flights to Tokyo\"."
      },
      {
        "text": "You have 2 open tasks: \"Prepare sprint review\" (HIGH, due today) and \"Reply to customer emails\"."
      },
      {
        "done": "Summarised the open tasks."
      }
    ],
    "expect": {
      "dataChanged": false,
      "guardrails": [
        "OUTPUT_UNKNOWN_TASK",
        "OUTPUT_REWRITTEN"
      ],
      "responseContains": [
        "Prepare sprint review",
        "Reply to customer emails"
      ],
      "responseNotContains": [
        "Tokyo"
      ]
    }
  },
