  {
    "id": "I07",
    "title": "An agent that cannot repair its answer leads to a safe fallback, never the invented text",
    "category": "GUARDRAIL",
    "fixture": [
      {
        "key": "a",
        "title": "Prepare sprint review",
        "priority": "HIGH",
        "dueDate": "2026-11-09"
      },
      {
        "key": "b",
        "title": "Reply to customer emails",
        "priority": "MEDIUM"
      }
    ],
    "turns": [
      "Summarise my open tasks"
    ],
    "script": [
      {
        "invokeAgent": "SummaryAgent",
        "request": "Summarise my open tasks"
      },
      {
        "toolCall": "findTasks",
        "arguments": {
          "statuses": [
            "TODO",
            "IN_PROGRESS"
          ]
        }
      },
      {
        "text": "Your tasks: \"Prepare sprint review\" and \"Book flights to Tokyo\"."
      },
      {
        "text": "Corrected: \"Prepare sprint review\" and \"Book flights to Tokyo\"."
      }
    ],
    "expect": {
      "dataChanged": false,
      "guardrails": [
        "OUTPUT_UNKNOWN_TASK",
        "OUTPUT_FALLBACK"
      ],
      "responseContains": [
        "couldn't put together a reliable answer",
        "No tasks were changed"
      ],
      "responseNotContains": [
        "Tokyo"
      ]
    }
  }
]
