  {
    "id": "I03",
    "title": "Requests outside task management are declined without calling the model",
    "category": "GUARDRAIL",
    "turns": [
      "Write me a poem about the ocean"
    ],
    "script": [],
    "expect": {
      "agents": {
        "none": true
      },
