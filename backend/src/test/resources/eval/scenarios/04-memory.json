[
  {
    "id": "M01",
    "title": "A follow-up turn ('its') resolves against the previous turn",
    "category": "MEMORY",
    "turns": [
      "Create a task called Prepare slides for Friday's demo",
      "Change its priority to high"
    ],
    "script": [
      {
        "invokeAgent": "TaskAgent",
        "request": "Create a task called Prepare slides for Friday's demo"
      },
      {
        "toolCall": "createTask",
        "arguments": {
          "title": "Prepare slides for Friday's demo"
        }
      },
      {
        "text": "Created \"Prepare slides for Friday's demo\" (MEDIUM)."
      },
      {
        "done": "Created the task."
      },
      {
        "invokeAgent": "TaskAgent",
        "request": "Change its priority to high"
      },
      {
        "toolCall": "updateTask",
        "arguments": {
          "taskId": "${title:slides}",
          "priority": "HIGH"
        }
      },
      {
        "text": "Changed the priority of \"Prepare slides for Friday's demo\" to HIGH."
      },
      {
        "done": "Updated the priority."
      }
    ],
    "expect": {
      "dataChanged": true,
      "tasks": [
        {
          "titleContains": "slides",
          "priority": "HIGH"
        }
      ],
      "taskCount": {
        "alice": 1
      }
    }
  },
