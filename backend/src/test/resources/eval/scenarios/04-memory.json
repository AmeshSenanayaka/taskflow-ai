  {
    "id": "M03",
    "title": "A rejected answer is not stored as conversation history",
    "category": "MEMORY",
    "fixture": [
      {
        "key": "a",
        "title": "Prepare sprint review",
        "priority": "HIGH",
        "dueDate": "2026-11-09"
      },
      {
        "key": "b",
        "title": "Reply to customer emails",
        "priority": "MEDIUM"
      }
    ],
    "turns": [
      "Show my open tasks"
    ],
    "script": [
      {
        "invokeAgent": "TaskAgent",
        "request": "Show my open tasks"
      },
      {
        "toolCall": "listTasks",
        "arguments": {
          "page": 0,
          "size": 20
        }
      },
      {
        "text": "Your open tasks: \"Prepare sprint review\" and \"Book flights to Tokyo\"."
      },
      {
        "text": "Corrected: \"Prepare sprint review\" and \"Book flights to Tokyo\"."
      }
    ],
    "expect": {
      "guardrails": [
        "OUTPUT_FALLBACK"
      ],
      "responseNotContains": [
        "Tokyo"
      ],
      "memoryNotContains": [
        "Tokyo"
      ]
    }
  },
  {
    "id": "M04",
    "title": "A repaired answer is stored without the rejected draft and the reprompt",
    "category": "MEMORY",
    "fixture": [
      {
        "key": "a",
        "title": "Prepare sprint review",
        "priority": "HIGH",
        "dueDate": "2026-11-09"
      },
      {
        "key": "b",
        "title": "Reply to customer emails",
        "priority": "MEDIUM"
      }
    ],
    "turns": [
      "Show my open tasks"
    ],
    "script": [
      {
        "invokeAgent": "TaskAgent",
